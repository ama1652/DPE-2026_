<bpmn:messageFlow id="M14" name="Klärungsergebnis" sourceRef="P_Team3" targetRef="CA_Lieferpruefung" />
<bpmn:messageFlow id="M15" name="Liefernachweis" sourceRef="SA_Nachweis" targetRef="P_Team1" />
