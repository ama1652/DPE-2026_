</bpmn:collaboration>
<bpmn:process id="T2_Materialversorgung" name="Materialversorgung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Hauptprozess Team 2: Ausgewählte Verbrauchsprodukte rechtzeitig und kontrolliert nachversorgen (Teamauftrag 2, Abschnitt 4). Eine Prozessinstanz = ein Nachversorgungsvorgang für ein Produkt eines Pflegehaushalts. Den Ist-Bestand führt Team 2 selbst in der Datenbank (führendes System). Drei Starts (Feedback Stiehl): Pflege-App (Nachricht), zyklischer Timer-Start, Bestand unterschritten (bedingter Start). Kleine Teilprozesse eingebettet und aufgeklappt, große als Call Activity (Feedback Stiehl 09.11.2026).</bpmn:documentation>
<bpmn:startEvent id="Start_Timer" name="Prüftermin erreicht (alle 10 Tage)"><bpmn:documentation>Zyklischer Timer-Start (Feedback Stiehl: Feature der Process Engine nutzen, kein eigener Prüflauf). Offen (Stiehl/Integrationskreis): Ein Timer-Start erzeugt je Zyklus eine Instanz ohne Haushalt und Produkt; wie die fälligen Versorgungsprofile zugeordnet werden, ist noch zu klären. Zyklus 10 Tage = Beispiel von Stiehl.</bpmn:documentation><bpmn:outgoing>F03</bpmn:outgoing><bpmn:timerEventDefinition id="Start_Timer_Def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P10D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="Start_Manuell" name="Bestand manuell gemeldet"><bpmn:documentation>Nachrichtenstart: Die Pflegeperson meldet über die Pflege-App einen abweichenden Ist-Bestand. Der gemeldete Wert wird in die Datenbank übernommen.</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing><bpmn:messageEventDefinition id="Start_Manuell_Def" messageRef="Msg_Bestandsmeldung" /></bpmn:startEvent>
<bpmn:startEvent id="Start_Bedingt" name="Bestand unterschritten"><bpmn:documentation>Bedingter Start (Feedback Stiehl): Team 2 führt den Bestand in der eigenen Datenbank. Fällt er unter den Mindestbestand des Versorgungsprofils, startet der Vorgang automatisch. Technik CIB seven: nach jeder Bestandsänderung REST "POST /condition" mit bestandMenge und mindestbestand (die Engine überwacht die Tabelle nicht selbst).</bpmn:documentation><bpmn:outgoing>F02</bpmn:outgoing><bpmn:conditionalEventDefinition id="Start_Bedingt_Def"><bpmn:condition xsi:type="bpmn:tFormalExpression">${bestandMenge &lt; mindestbestand}</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:exclusiveGateway id="GW_Start" name=""><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlBestellversuche', 0)}" event="start" /></bpmn:extensionElements><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F02</bpmn:incoming><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:subProcess id="SP_Bedarf" name="Bedarfsermittlung"><bpmn:documentation>Eingebetteter Teilprozess zu Schritt 2 und 3 (Verbrauch und Reichweite, Nachversorgungsbedarf). Keine medizinische Beurteilung des Bedarfs (Teamauftrag 2, 3.2).</bpmn:documentation><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:startEvent id="SB_Start" name="Bedarfsprüfung begonnen"><bpmn:outgoing>SF1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="SB_Reichweite" name="Verbrauch und Reichweite berechnen" camunda:type="external" camunda:topic="t2-reichweite-berechnen"><bpmn:documentation>Liest Ist-Bestand, Verbrauchsannahme und Zielbestand aus der eigenen Datenbank (kein erneutes Abfragen bei der Pflegeperson). Ergebnis: Reichweite in Tagen, verbrauchssprung bei deutlich verändertem Verbrauch (keine stille Mengenerhöhung).</bpmn:documentation><bpmn:incoming>SF1</bpmn:incoming><bpmn:outgoing>SF2</bpmn:outgoing></bpmn:serviceTask><bpmn:businessRuleTask id="SB_Bedarf" name="Nachversorgungsbedarf feststellen" camunda:type="external" camunda:topic="t2-bedarf-feststellen"><bpmn:documentation>Regel: Reicht der Bestand bis zum nächsten Prüf- oder Liefertermin? Setzt nachversorgungErforderlich. Später als DMN-Tabelle.</bpmn:documentation><bpmn:incoming>SF2</bpmn:incoming><bpmn:outgoing>SF3</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="SB_GW" name="Nachversorgung erforderlich?"><bpmn:incoming>SF3</bpmn:incoming><bpmn:outgoing>SF4</bpmn:outgoing><bpmn:outgoing>SF5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="SB_Erforderlich" name="Nachversorgung erforderlich"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bedarfsermittlungErgebnis', 'Nachversorgung erforderlich')}" event="start" /></bpmn:extensionElements><bpmn:incoming>SF4</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="SB_Termin" name="Nächste Prüfung terminieren" camunda:type="external" camunda:topic="t2-pruefung-terminieren"><bpmn:incoming>SF5</bpmn:incoming><bpmn:outgoing>SF6</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="SB_Ausreichend" name="Bestand ausreichend"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bedarfsermittlungErgebnis', 'Bestand ausreichend')}" event="start" /></bpmn:extensionElements><bpmn:incoming>SF6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="SF1" sourceRef="SB_Start" targetRef="SB_Reichweite"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF2" sourceRef="SB_Reichweite" targetRef="SB_Bedarf"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF3" sourceRef="SB_Bedarf" targetRef="SB_GW"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF4" sourceRef="SB_GW" targetRef="SB_Erforderlich" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachversorgungErforderlich}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF5" sourceRef="SB_GW" targetRef="SB_Termin" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!nachversorgungErforderlich}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="SF6" sourceRef="SB_Termin" targetRef="SB_Ausreichend"></bpmn:sequenceFlow></bpmn:subProcess>
<bpmn:exclusiveGateway id="GW_Bedarf" name="Nachversorgung erforderlich?"><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ausreichend" name="Bestand ausreichend"><bpmn:incoming>F07</bpmn:incoming></bpmn:endEvent>
<bpmn:callActivity id="CA_Bestellfreigabe" name="Bestellfreigabe" calledElement="T2_Bestellfreigabe" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="produktId" target="produktId" /><camunda:in source="nachversorgungsbedarf" target="nachversorgungsbedarf" /><camunda:in source="verbrauchssprung" target="verbrauchssprung" /><camunda:in source="ersatzGrund" target="ersatzGrund" /><camunda:in source="anzahlBestellversuche" target="anzahlBestellversuche" /><camunda:out source="bestellfreigabeErgebnis" target="bestellfreigabeErgebnis" /><camunda:out source="bestellvorschlag" target="bestellvorschlag" /></bpmn:extensionElements><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Freigabe" name="Bestellung freigegeben?"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_KeineEinigung" name="Keine Einigung"><bpmn:incoming>F11</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
<bpmn:callActivity id="CA_Bestellabwicklung" name="Bestellabwicklung" calledElement="T2_Bestellabwicklung" camunda:calledElementBinding="latest"><bpmn:documentation>Zählt die Bestellversuche (anzahlBestellversuche). Ab dem 2. Versuch setzt die Berechtigungsregel den Weg PRUEFUNG, damit die Ersatz-Schleife nicht endlos läuft. Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen):</bpmn:documentation><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="bestellvorschlag" target="bestellvorschlag" /><camunda:out source="bestellabwicklungErgebnis" target="bestellabwicklungErgebnis" /><camunda:out source="bestellung" target="bestellung" /><camunda:out source="ersatzGrund" target="ersatzGrund" /><camunda:executionListener expression="${execution.setVariable('anzahlBestellversuche', anzahlBestellversuche + 1)}" event="start" /></bpmn:extensionElements><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Bestellung" name="Bestellung bestätigt?"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_Lieferpruefung" name="Lieferprüfung" calledElement="T2_Lieferpruefung" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="bestellung" target="bestellung" /><camunda:out source="lieferpruefungErgebnis" target="lieferpruefungErgebnis" /><camunda:out source="lieferung" target="lieferung" /></bpmn:extensionElements><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_Lieferung" name="Lieferung abgeschlossen?"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing><bpmn:outgoing>F18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ungeklaert" name="Lieferung ungeklärt"><bpmn:incoming>F18</bpmn:incoming></bpmn:endEvent>
<bpmn:subProcess id="SP_Abschluss" name="Vorgangsabschluss"><bpmn:documentation>Eingebetteter Teilprozess zu Schritt 11 und 12 (Bestand fortschreiben, Beleg übergeben, Ergebnis mitteilen).</bpmn:documentation><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing><bpmn:startEvent id="SA_Start" name="Abschluss begonnen"><bpmn:outgoing>AF1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="SA_Fortschreiben" name="Bestand und Verbrauch fortschreiben" camunda:type="external" camunda:topic="t2-bestand-fortschreiben"><bpmn:documentation>Neuer Ist-Bestand, neue Reichweite und nächster Prüfzeitpunkt werden in der eigenen Datenbank gespeichert.</bpmn:documentation><bpmn:incoming>AF1</bpmn:incoming><bpmn:outgoing>AF2</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="SA_Nachweis" name="Liefernachweis übergeben" camunda:type="external" camunda:topic="t2-nachweis-uebergeben"><bpmn:documentation>Übergabe an Team 1 (Bestellbeleg/Liefernachweis). Schnittstelle = Vorschlag zur Abstimmung im Integrationskreis.</bpmn:documentation><bpmn:incoming>AF2</bpmn:incoming><bpmn:outgoing>AF3</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="SA_Ergebnis" name="Ergebnis mitteilen" camunda:type="external" camunda:topic="t2-ergebnis-mitteilen"><bpmn:documentation>Nachricht an die Pflege-App (eigenständiges System): Lieferung abgeschlossen, neuer Bestand.</bpmn:documentation><bpmn:incoming>AF3</bpmn:incoming><bpmn:outgoing>AF4</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="SA_End" name="Vorgang geschlossen"><bpmn:incoming>AF4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AF1" sourceRef="SA_Start" targetRef="SA_Fortschreiben"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AF2" sourceRef="SA_Fortschreiben" targetRef="SA_Nachweis"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AF3" sourceRef="SA_Nachweis" targetRef="SA_Ergebnis"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AF4" sourceRef="SA_Ergebnis" targetRef="SA_End"></bpmn:sequenceFlow></bpmn:subProcess>
<bpmn:endEvent id="End_Abgeschlossen" name="Nachversorgung abgeschlossen"><bpmn:incoming>F19</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start_Manuell" targetRef="GW_Start"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="Start_Bedingt" targetRef="GW_Start"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="Start_Timer" targetRef="GW_Start"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="GW_Start" targetRef="SP_Bedarf"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="SP_Bedarf" targetRef="GW_Bedarf"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_Bedarf" targetRef="CA_Bestellfreigabe" name="Nachversorgung erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bedarfsermittlungErgebnis == 'Nachversorgung erforderlich'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="GW_Bedarf" targetRef="End_Ausreichend" name="Bestand ausreichend"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bedarfsermittlungErgebnis == 'Bestand ausreichend'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="CA_Bestellfreigabe" targetRef="GW_Freigabe"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="GW_Freigabe" targetRef="CA_Bestellabwicklung" name="Bestellung freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="GW_Freigabe" targetRef="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung nicht freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" sourceRef="GW_Freigabe" targetRef="End_KeineEinigung" name="Keine Einigung"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Keine Einigung'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" sourceRef="GW_Freigabe" targetRef="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellfreigabeErgebnis == 'Bestellung nicht zulässig'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F13" sourceRef="CA_Bestellabwicklung" targetRef="GW_Bestellung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F14" sourceRef="GW_Bestellung" targetRef="CA_Lieferpruefung" name="Bestellung bestätigt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellabwicklungErgebnis == 'Bestellung bestätigt'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F15" sourceRef="GW_Bestellung" targetRef="CA_Bestellfreigabe" name="Ersatz erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellabwicklungErgebnis == 'Ersatz erforderlich'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F16" sourceRef="CA_Lieferpruefung" targetRef="GW_Lieferung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F17" sourceRef="GW_Lieferung" targetRef="SP_Abschluss" name="Lieferung abgeschlossen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferpruefungErgebnis == 'Lieferung abgeschlossen'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F18" sourceRef="GW_Lieferung" targetRef="End_Ungeklaert" name="Lieferung ungeklärt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferpruefungErgebnis == 'Lieferung ungeklärt'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F19" sourceRef="SP_Abschluss" targetRef="End_Abgeschlossen"></bpmn:sequenceFlow>
</bpmn:process>
