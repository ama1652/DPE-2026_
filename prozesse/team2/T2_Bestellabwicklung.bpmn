      <bpmndi:BPMNShape id="GW_Ers_di" bpmnElement="GW_Ers" isMarkerVisible="true">
        <dc:Bounds x="995" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="981" y="383" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Ersatz_di" bpmnElement="End_Ersatz">
        <dc:Bounds x="1112" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1164" y="426" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_KeineBestellung_di" bpmnElement="End_KeineBestellung">
        <dc:Bounds x="1002" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1058" y="536" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Frist_di" bpmnElement="B_Frist">
        <dc:Bounds x="572" y="322" width="36" height="36" />
