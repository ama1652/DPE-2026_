<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Bestellabwicklung" targetNamespace="http://thi.de/dpe/team2" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collab_T2_Bestellabwicklung">
    <bpmn:participant id="P_Lieferant" name="Lieferant (simuliert)" />
    <bpmn:participant id="P_Bestellabwicklung" name="Bestellabwicklung - Materialversorgung (Team 2)" processRef="T2_Bestellabwicklung" />
    <bpmn:participant id="P_Team3" name="Team 3 - Kommunikation, Fristen, Nachfassen" />
    <bpmn:messageFlow id="M01" name="Bestellung" sourceRef="S_Bestellung" targetRef="P_Lieferant" />
    <bpmn:messageFlow id="M02" name="Bestell-Antwort" sourceRef="P_Lieferant" targetRef="R_Antwort" />
    <bpmn:messageFlow id="M03" name="Nachfass-Auftrag" sourceRef="S_Nachfassen" targetRef="P_Team3" />
  </bpmn:collaboration>
  <bpmn:process id="T2_Bestellabwicklung" name="Bestellabwicklung" isExecutable="true" camunda:historyTimeToLive="P180D">
    <bpmn:documentation>Teilprozess zu Schritt 8 und 9. Happy Path als Empfangsaufgabe mit angehängtem Timer. Nicht verfügbar oder keine Antwort trotz Nachfassen -&gt; Ersatzoption prüfen -&gt; Ersatz erforderlich oder Keine Bestellung möglich (Stiehl Punkt 7). Pflichtpunkt: Sendeaufgabe -&gt; JMS-Queue (Camel/CBR), Antwort über Camel.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Bestellung freigegeben">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;nachgefasst&#39;, false)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="S_Bestellung" name="Bestellung übermitteln" camunda:type="external" camunda:topic="t2-bestellung-senden">
      <bpmn:documentation>Bestellnachricht in JMS-Queue; Camel routet per CBR an den simulierten Lieferdienst.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="XOR_W" name="">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="R_Antwort" name="Bestellantwort empfangen" messageRef="Msg_Bestellantwort">
      <bpmn:documentation>Antwort des Lieferanten über Camel. bestellantwortStatus: BESTAETIGT oder NICHT_VERFUEGBAR.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="GW_A" name="Bestellung bestätigt?">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Bestaetigt" name="Bestellung bestätigt">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;bestellabwicklungErgebnis&#39;, &#39;Bestellung bestätigt&#39;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_N" name="Bereits nachgefasst?">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S_Nachfassen" name="Nachfassen beauftragen" camunda:type="external" camunda:topic="t2-nachfassen-beauftragen">
      <bpmn:documentation>Kommunikationsauftrag an Team 3. Schnittstelle = Vorschlag.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;nachgefasst&#39;, true)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="XOR_E" name="">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Ersatz" name="Ersatzoption prüfen" camunda:type="external" camunda:topic="t2-ersatzoption-pruefen">
      <bpmn:documentation>Gibt es eine hinterlegte, zugelassene Ersatzoption und ist anzahlBestellversuche &lt; 2? Ergebnis ersatzMoeglich. Begrenzt die Ersatz-Schleife im Hauptprozess. Kein medizinischer Ersatz.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Ers" name="Ersatz möglich?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Ersatz" name="Ersatz erforderlich">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;bestellabwicklungErgebnis&#39;, &#39;Ersatz erforderlich&#39;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_KeineBestellung" name="Keine Bestellung möglich">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;bestellabwicklungErgebnis&#39;, &#39;Keine Bestellung möglich&#39;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_Frist" name="Antwortfrist abgelaufen (1 Tag)" attachedToRef="R_Antwort">
      <bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Antwortfrist Lieferant 1 Tag.</bpmn:documentation>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_Frist_Def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="S_Bestellung" />
    <bpmn:sequenceFlow id="F02" sourceRef="S_Bestellung" targetRef="XOR_W" />
    <bpmn:sequenceFlow id="F09" sourceRef="S_Nachfassen" targetRef="XOR_W" />
    <bpmn:sequenceFlow id="F03" sourceRef="XOR_W" targetRef="R_Antwort" />
    <bpmn:sequenceFlow id="F04" sourceRef="R_Antwort" targetRef="GW_A" />
    <bpmn:sequenceFlow id="F05" name="Ja" sourceRef="GW_A" targetRef="End_Bestaetigt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellantwortStatus == 'BESTAETIGT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F06" name="Nicht verfügbar" sourceRef="GW_A" targetRef="XOR_E">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;ersatzGrund&#39;, &#39;Produkt nicht verfügbar&#39;)}" event="take" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellantwortStatus == 'NICHT_VERFUEGBAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F07" sourceRef="B_Frist" targetRef="GW_N" />
    <bpmn:sequenceFlow id="F08" name="Nein" sourceRef="GW_N" targetRef="S_Nachfassen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!nachgefasst}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" name="Ja" sourceRef="GW_N" targetRef="XOR_E">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;ersatzGrund&#39;, &#39;Lieferant antwortet nicht&#39;)}" event="take" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachgefasst}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="XOR_E" targetRef="T_Ersatz" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Ersatz" targetRef="GW_Ers" />
    <bpmn:sequenceFlow id="F13" name="Ja" sourceRef="GW_Ers" targetRef="End_Ersatz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ersatzMoeglich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" name="Nein" sourceRef="GW_Ers" targetRef="End_KeineBestellung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!ersatzMoeglich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:message id="Msg_Bestellantwort" name="Lieferant_Bestellantwort_Team2" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_T2_Bestellabwicklung">
      <bpmndi:BPMNShape id="P_Lieferant_di" bpmnElement="P_Lieferant" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1220" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Bestellabwicklung_di" bpmnElement="P_Bestellabwicklung" isHorizontal="true">
        <dc:Bounds x="120" y="180" width="1220" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="187" y="282" width="36" height="36" />
