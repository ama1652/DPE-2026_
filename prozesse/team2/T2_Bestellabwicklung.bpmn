<?xml version="1.0" encoding="UTF-8"?>
<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: offen (Team 2 legt fest). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Bestellabwicklung" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Bestellabwicklung">
<bpmn:participant id="P_Lieferant" name="Lieferant (simuliert)" />
<bpmn:participant id="P_Bestellabwicklung" name="Bestellabwicklung" processRef="T2_Bestellabwicklung" />
<bpmn:participant id="P_Team3" name="Team 3 - Kommunikation, Fristen, Nachfassen" />
<bpmn:messageFlow id="M01" name="Bestellung" sourceRef="S_Bestellung" targetRef="P_Lieferant" />
<bpmn:messageFlow id="M02" name="Bestellantwort" sourceRef="P_Lieferant" targetRef="R_Antwort" />
<bpmn:messageFlow id="M03" name="Nachfassauftrag" sourceRef="S_Nachfassen" targetRef="P_Team3" />
</bpmn:collaboration>
<bpmn:process id="T2_Bestellabwicklung" name="Bestellabwicklung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Teilprozess zu Schritt 8 (Bestellung simuliert auslösen) und 9 (Bestätigung überwachen). Happy Path (Lieferant antwortet) als Empfangsaufgabe mit angehängtem Timer statt ereignisbasiertem Gateway (Feedback Stiehl). Pflichtpunkt Projektvorgaben: Sendeaufgabe -&gt; JMS-Queue (Camel/CBR), Antwort des Backend-Systems über Camel.</bpmn:documentation>
<bpmn:startEvent id="Start" name="Bestellung freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('nachgefasst', false)}" event="start" /></bpmn:extensionElements><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="S_Bestellung" name="Bestellung übermitteln" camunda:type="external" camunda:topic="t2-bestellung-senden"><bpmn:documentation>Bestellnachricht (JSON/XML) asynchron in JMS-Queue; Apache Camel routet per CBR an den simulierten Lieferdienst. Keine echte Bestellung (Handbuch 12.1).</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="GW_Warten" name=""><bpmn:incoming>F02</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:receiveTask id="R_Antwort" name="Bestellantwort empfangen" messageRef="Msg_Bestellantwort"><bpmn:documentation>Nachricht des Lieferanten über Camel (Korrelation über vorgangId). Variable bestellantwortStatus: BESTAETIGT oder NICHT_VERFUEGBAR.</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="B_Frist" name="Antwortfrist abgelaufen (1 Tag)" attachedToRef="R_Antwort"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Antwortfrist Lieferant 1 Tag.</bpmn:documentation><bpmn:outgoing>F07</bpmn:outgoing><bpmn:timerEventDefinition id="B_Frist_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW_Bestaetigt" name="Bestellung bestätigt?"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Bestaetigt" name="Bestellung bestätigt"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellabwicklungErgebnis', 'Bestellung bestätigt')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F05</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Nachgefasst" name="Bereits nachgefasst?"><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing><bpmn:outgoing>F09</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Ersatz" name="Ersatz erforderlich"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellabwicklungErgebnis', 'Ersatz erforderlich')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F08</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="S_Nachfassen" name="Nachfassen beauftragen" camunda:type="external" camunda:topic="t2-nachfassen-beauftragen"><bpmn:documentation>Kommunikationsauftrag an Team 3 (Gegenstelle, Nachricht, Antwortfrist). Schnittstelle = Vorschlag.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('nachgefasst', true)}" event="end" /></bpmn:extensionElements><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:sendTask>
<bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="S_Bestellung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="S_Bestellung" targetRef="GW_Warten"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="GW_Warten" targetRef="R_Antwort"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="R_Antwort" targetRef="GW_Bestaetigt"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="GW_Bestaetigt" targetRef="End_Bestaetigt" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellantwortStatus == 'BESTAETIGT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_Bestaetigt" targetRef="End_Ersatz" name="Nicht verfügbar"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ersatzGrund', 'Produkt nicht verfügbar')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestellantwortStatus == 'NICHT_VERFUEGBAR'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="B_Frist" targetRef="GW_Nachgefasst"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="GW_Nachgefasst" targetRef="End_Ersatz" name="Ja"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ersatzGrund', 'Lieferant antwortet nicht')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachgefasst}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="GW_Nachgefasst" targetRef="S_Nachfassen" name="Nein"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!nachgefasst}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="S_Nachfassen" targetRef="GW_Warten"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:message id="Msg_Bestellantwort" name="Lieferant_Bestellantwort_Team2" />
