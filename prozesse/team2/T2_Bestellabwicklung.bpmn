        <dc:Bounds x="565" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="452" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Nachfassen_di" bpmnElement="S_Nachfassen">
        <dc:Bounds x="520" y="500" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_E_di" bpmnElement="XOR_E" isMarkerVisible="true">
        <dc:Bounds x="715" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Ersatz_di" bpmnElement="T_Ersatz">
        <dc:Bounds x="810" y="400" width="140" height="80" />
