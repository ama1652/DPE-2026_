<?xml version="1.0" encoding="UTF-8"?>
<!-- KI-generiert (Claude, Anthropic) - Beginn. Team 2 Materialversorgung, Pflege-Backoffice MVP, DPE WS 2026/27 (Prof. Stiehl). Verantwortlich im Team: offen (Team 2 legt fest). Lizenz: MIT. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Kundenentscheidung" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 (KI-unterstützt)" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Kundenentscheidung">
<bpmn:participant id="P_PflegeApp" name="Pflege-App" />
<bpmn:participant id="P_Kundenentscheidung" name="Kundenentscheidung (gemeinsamer Baustein)" processRef="T2_Kundenentscheidung" />
<bpmn:messageFlow id="M01" name="Freigabe­anfrage" sourceRef="S_Anfrage" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M02" name="Kunden­entscheidung" sourceRef="P_PflegeApp" targetRef="R_Entscheidung" />
<bpmn:messageFlow id="M03" name="Erinnerung" sourceRef="S_Erinnern" targetRef="P_PflegeApp" />
</bpmn:collaboration>
<bpmn:process id="T2_Kundenentscheidung" name="Kundenentscheidung" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Gemeinsamer, wiederverwendbarer Baustein (Team 2 verantwortet Kundenfreigaben, Handbuch 6.2 / 7.4). Die Pflege-App ist ein eigenständiges System: Freigabeanfrage senden, Entscheidung empfangen (Feedback Stiehl 09.11.2026, keine Benutzeraufgabe in der Tasklist). Eingaben: freigabeHandlung, freigabeBegruendung, freigabeFolgen, freigabeGueltigBis. Ergebnis kundenentscheidungErgebnis: Freigegeben | Änderung gewünscht | Nicht freigegeben. Keine stillschweigende Freigabe bei fehlender Antwort.</bpmn:documentation>
<bpmn:startEvent id="Start" name="Entscheidung angefordert"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="S_Anfrage" name="Freigabeanfrage senden" camunda:type="external" camunda:topic="t2-freigabeanfrage-senden"><bpmn:documentation>Nachricht an die Pflege-App mit Handlung, Begründung, Folgen und Gültigkeit.</bpmn:documentation><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:sendTask>
<bpmn:receiveTask id="R_Entscheidung" name="Kundenentscheidung empfangen" messageRef="Msg_Kundenentscheidung"><bpmn:documentation>Antwort aus der Pflege-App. Variable entscheidung: FREIGEBEN, AENDERN, ABLEHNEN oder AUFSCHIEBEN, dazu kundenentscheidungKommentar. Korrelation über vorgangId.</bpmn:documentation><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="B_Erinnerung" name="Erinnerung fällig (1 Tag)" attachedToRef="R_Entscheidung" cancelActivity="false"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Erinnerung nach 1 Tag.</bpmn:documentation><bpmn:outgoing>F7</bpmn:outgoing><bpmn:timerEventDefinition id="B_Erinnerung_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="B_Frist" name="Antwortfrist abgelaufen (3 Tage)" attachedToRef="R_Entscheidung"><bpmn:documentation>Projektannahme (nicht von Stiehl vorgegeben, im Integrationskreis bestätigen): Antwortfrist 3 Tage; danach "Nicht freigegeben" (keine stillschweigende Freigabe).</bpmn:documentation><bpmn:outgoing>F9</bpmn:outgoing><bpmn:timerEventDefinition id="B_Frist_Def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="S_Erinnern" name="An Freigabe erinnern" camunda:type="external" camunda:topic="t2-freigabeerinnerung-senden"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="End_Erinnert" name="Erinnerung gesendet"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Entscheidung" name="Entscheidung?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Freigegeben" name="Freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Aenderung" name="Änderung gewünscht"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Änderung gewünscht')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_NichtFreigegeben" name="Nicht freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungErgebnis', 'Nicht freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="S_Anfrage"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F2" sourceRef="S_Anfrage" targetRef="R_Entscheidung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F3" sourceRef="R_Entscheidung" targetRef="GW_Entscheidung"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F4" sourceRef="GW_Entscheidung" targetRef="End_Freigegeben" name="Freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'FREIGEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F5" sourceRef="GW_Entscheidung" targetRef="End_Aenderung" name="Änderung gewünscht"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AENDERN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F6" sourceRef="GW_Entscheidung" targetRef="End_NichtFreigegeben" name="Abgelehnt oder aufgeschoben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'ABLEHNEN' || entscheidung == 'AUFSCHIEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F7" sourceRef="B_Erinnerung" targetRef="S_Erinnern"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F8" sourceRef="S_Erinnern" targetRef="End_Erinnert"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F9" sourceRef="B_Frist" targetRef="End_NichtFreigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('kundenentscheidungKommentar', 'Keine Rückmeldung innerhalb der Frist')}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:message id="Msg_Kundenentscheidung" name="PflegeApp_Kundenentscheidung_Team2" />
