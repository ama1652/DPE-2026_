<bpmndi:BPMNEdge id="F07_di" bpmnElement="F07"><di:waypoint x="720" y="365" /><di:waypoint x="720" y="700" /><bpmndi:BPMNLabel><dc:Bounds x="728" y="560" width="70" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F08_di" bpmnElement="F08"><di:waypoint x="790" y="740" /><di:waypoint x="855" y="740" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F09_di" bpmnElement="F09"><di:waypoint x="880" y="715" /><di:waypoint x="880" y="365" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="560" width="70" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
