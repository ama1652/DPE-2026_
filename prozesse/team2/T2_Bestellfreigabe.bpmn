      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Pruef_di" bpmnElement="GW_Pruef" isMarkerVisible="true">
        <dc:Bounds x="955" y="655" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="946" y="709" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NichtZulaessig_di" bpmnElement="End_NichtZulaessig">
        <dc:Bounds x="1072" y="662" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1130" y="666" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_di" bpmnElement="F01">
        <di:waypoint x="308" y="410" />
