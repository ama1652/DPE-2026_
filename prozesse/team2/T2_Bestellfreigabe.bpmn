<?xml version="1.0" encoding="UTF-8"?>
<!-- Verantwortlich: Saifudin Mohammadi (Modell erstellt; Review gegen Stiehls 11 Punkte und einzelne Verbesserungen: Amar, Erion, Mohammed) -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_T2_Bestellfreigabe" targetNamespace="http://thi.de/dpe/team2" exporter="Team 2 Materialversorgung" exporterVersion="1.0">
<bpmn:collaboration id="Collab_T2_Bestellfreigabe">
<bpmn:participant id="P_Team3" name="Team 3 - Kommunikation, Fristen, Nachfassen" />
<bpmn:participant id="P_PflegeApp" name="Pflege-App" />
<bpmn:participant id="P_Bestellfreigabe" name="Bestellfreigabe - Materialversorgung (Team 2)" processRef="T2_Bestellfreigabe" />
<bpmn:messageFlow id="M01" name="Freigabe-Anfrage" sourceRef="CA_KE" targetRef="P_PflegeApp" />
<bpmn:messageFlow id="M02" name="Kunden-Entscheidung" sourceRef="P_PflegeApp" targetRef="CA_KE" />
<bpmn:messageFlow id="M03" name="Nachfass-Auftrag" sourceRef="CA_KE" targetRef="P_Team3" />
</bpmn:collaboration>
<bpmn:process id="T2_Bestellfreigabe" name="Bestellfreigabe" isExecutable="true" camunda:historyTimeToLive="P180D">
<bpmn:documentation>Teilprozess zu Schritt 4-7. Eine Abweichung führt nicht zur Ablehnung, sondern zu einer menschlichen Entscheidung (Kunde oder Prüfstelle). Die Prüfstelle kann bewusst nicht ohne Kunde freigeben (Entscheidung T2-006, Stiehl Punkt 6). Ergebnis bestellfreigabeErgebnis, Grund in ablehnungsgrund.</bpmn:documentation>
<bpmn:laneSet id="T2_Bestellfreigabe_LaneSet">
<bpmn:lane id="Lane_System" name="Materialversorgung (Team 2) - automatisiert"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_V</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Vorschlag</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Regel</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Weg</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_KE</bpmn:flowNodeRef><bpmn:flowNodeRef>CA_KE</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_KE</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_Frei</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Freigegeben</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Aufgeschoben</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Weiter</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_N</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NichtFreigegeben</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Pruefstelle" name="Materialversorgung (Team 2) - menschliche Prüfstelle"><bpmn:flowNodeRef>UT_Grenzfall</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Pruef</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NichtZulaessig</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Bestellvorschlag angefordert"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlVorschlaege', 0)}" event="start" /></bpmn:extensionElements><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="XOR_V" name=""><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_Vorschlag" name="Produkt und Menge vorschlagen" camunda:type="external" camunda:topic="t2-vorschlag-erstellen"><bpmn:documentation>Bevorzugtes Produkt aus dem Versorgungsprofil; Menge = Zielbestand minus Ist-Bestand, aufgerundet auf die Packung. Bei ersatzGrund oder Änderungswunsch nur hinterlegte Ersatzoptionen. Zählt anzahlVorschlaege.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlVorschlaege', anzahlVorschlaege + 1)}" event="end" /></bpmn:extensionElements><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="T_Regel" name="Berechtigungsregel anwenden" camunda:decisionRef="Berechtigungsregel" camunda:decisionRefBinding="latest" camunda:mapDecisionResult="singleResult" camunda:resultVariable="berechtigungErgebnis"><bpmn:documentation>DMN "Berechtigungsregel" (T2_Berechtigungsregel.dmn, Verantwortlich: Saifudin Mohammadi, erste Fassung Mohammed): ermittelt die Abweichungen (Preis, Produktwechsel, Verbrauchssprung, Lieferant, Menge) und daraus freigabeweg = AUTOMATISCH, KUNDENFREIGABE oder PRUEFUNG. Ersetzt "Abweichungen prüfen" (Stiehl Punkt 11). Die Engine wertet die Tabelle selbst aus (decisionRef). Hit Policy FIRST, mit Prof. Stiehl am 25.11. besprochen.</bpmn:documentation><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('freigabeweg', berechtigungErgebnis.freigabeweg)}" event="end" /><camunda:executionListener expression="${execution.setVariable('freigabeBegruendung', berechtigungErgebnis.freigabeBegruendung)}" event="end" /></bpmn:extensionElements><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="GW_Weg" name="Freigabeweg?"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="XOR_KE" name=""><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_KE" name="Kundenentscheidung" calledElement="T2_Kundenentscheidung" camunda:calledElementBinding="latest"><bpmn:documentation>Gemeinsamer Baustein Kundenentscheidung (auch für Team 1 und Team 3).</bpmn:documentation><bpmn:extensionElements><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="freigabeHandlung" target="freigabeHandlung" /><camunda:in source="freigabeBegruendung" target="freigabeBegruendung" /><camunda:in source="freigabeFolgen" target="freigabeFolgen" /><camunda:in source="freigabeGueltigBis" target="freigabeGueltigBis" /><camunda:out source="kundenentscheidungErgebnis" target="kundenentscheidungErgebnis" /><camunda:out source="kundenentscheidungGrund" target="kundenentscheidungGrund" /></bpmn:extensionElements><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:callActivity>
<bpmn:exclusiveGateway id="GW_KE" name="Entscheidung?"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="XOR_Frei" name=""><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Freigegeben" name="Bestellung freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F19</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Aufgeschoben" name="Bestellung aufgeschoben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung aufgeschoben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="XOR_N" name=""><bpmn:incoming>F15</bpmn:incoming><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtFreigegeben" name="Bestellung nicht freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung nicht freigegeben')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F20</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW_Weiter" name="Weiterer Vorschlag möglich?"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing><bpmn:outgoing>F18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="UT_Grenzfall" name="Grenzfall prüfen" camunda:candidateGroups="pruefstelle"><bpmn:documentation>Anlass: ungewöhnlicher Verbrauch, ungeklärtes Produkt oder Grenzfall. Rolle: menschliche Prüfstelle (Mitarbeitende von Team 2, Tasklist). Ergebnis: Kundenfreigabe einholen oder nicht zulässig. Ein "zulässig ohne Kunde" gibt es bewusst nicht: jede Abweichung entscheidet der Kunde (T2-006).</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="freigabeBegruendung" label="Anlass der Prüfung" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="pruefergebnis" label="Prüfergebnis" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="KUNDENFREIGABE" name="Kundenfreigabe einholen" /><camunda:value id="NICHT_ZULAESSIG" name="Nicht zulässig" /></camunda:formField><camunda:formField id="pruefbegruendung" label="Begründung" type="string"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField></camunda:formData></bpmn:extensionElements><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GW_Pruef" name="Prüfergebnis?"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_NichtZulaessig" name="Bestellung nicht zulässig"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('bestellfreigabeErgebnis', 'Bestellung nicht zulässig')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ablehnungsgrund', 'Prüfstelle: nicht zulässig')}" event="start" /></bpmn:extensionElements><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="XOR_V"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F02" sourceRef="XOR_V" targetRef="T_Vorschlag"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F03" sourceRef="T_Vorschlag" targetRef="T_Regel"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F04" sourceRef="T_Regel" targetRef="GW_Weg"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F05" sourceRef="GW_Weg" targetRef="XOR_KE" name="Kundenfreigabe erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'KUNDENFREIGABE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F06" sourceRef="GW_Weg" targetRef="XOR_Frei" name="Automatisch zulässig"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'AUTOMATISCH'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F07" sourceRef="GW_Weg" targetRef="UT_Grenzfall" name="Prüfung erforderlich"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'PRUEFUNG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F08" sourceRef="UT_Grenzfall" targetRef="GW_Pruef"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F09" sourceRef="GW_Pruef" targetRef="XOR_KE" name="Kundenfreigabe einholen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pruefergebnis == 'KUNDENFREIGABE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="GW_Pruef" targetRef="End_NichtZulaessig" name="Nicht zulässig"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pruefergebnis == 'NICHT_ZULAESSIG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" sourceRef="XOR_KE" targetRef="CA_KE"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" sourceRef="CA_KE" targetRef="GW_KE"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F13" sourceRef="GW_KE" targetRef="XOR_Frei" name="Freigegeben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F14" sourceRef="GW_KE" targetRef="End_Aufgeschoben" name="Aufgeschoben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ablehnungsgrund', 'Kunde: aufgeschoben')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Aufgeschoben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F15" sourceRef="GW_KE" targetRef="XOR_N" name="Nicht freigegeben"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ablehnungsgrund', kundenentscheidungGrund)}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Nicht freigegeben'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F16" sourceRef="GW_KE" targetRef="GW_Weiter" name="Änderung gewünscht"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kundenentscheidungErgebnis == 'Änderung gewünscht'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F17" sourceRef="GW_Weiter" targetRef="XOR_V" name="Ja"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzahlVorschlaege &lt; 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F18" sourceRef="GW_Weiter" targetRef="XOR_N" name="Nein (keine Einigung)"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ablehnungsgrund', 'Keine Einigung nach 3 Vorschlägen')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzahlVorschlaege &gt;= 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F19" sourceRef="XOR_Frei" targetRef="End_Freigegeben"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F20" sourceRef="XOR_N" targetRef="End_NichtFreigegeben"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="BPMNDiagram_1"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_T2_Bestellfreigabe">
